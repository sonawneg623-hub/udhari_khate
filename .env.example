# लोकल चालवण्यासाठी: या फाइलची कॉपी .env नावाने बनवू नका – फक्त terminal मध्ये export करा किंवा Render मध्ये टाका.
# DATABASE_URL रिकामा ठेवला तर लोकल SQLite (instance/udhari.db) वापरली जाते.
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SHOP_NAME=श्री गणेश किराणा स्टोअर्स
